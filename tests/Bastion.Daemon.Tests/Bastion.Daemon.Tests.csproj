<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches Bastion.Daemon.csproj's own TFM — a project referencing it cannot target a lower
         TargetPlatformVersion (NU1201). -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>Bastion.Daemon.Tests</RootNamespace>
    <AssemblyName>Bastion.Daemon.Tests</AssemblyName>
    <Platforms>x64;arm64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bastion.Daemon\Bastion.Daemon.csproj" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />

    <!-- FakeTimeProvider for deterministic hot-reload debounce tests (testing.md §4). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />

    <!-- Verify-snapshots the exported JSON Schema shape (testing.md §6, json-ipc-config.md §3). -->
    <PackageReference Include="Verify.XunitV3" />
  </ItemGroup>

</Project>
