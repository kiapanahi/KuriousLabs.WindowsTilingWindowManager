<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Matches Bastion.Win32.csproj's own TFM (GitHub issue #6) — a project referencing
         Bastion.Win32 cannot target a lower TargetPlatformVersion than it does (NU1201); see that
         project's comment for the full GetSystemMetricsForDpi/GetDpiForSystem rationale. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>Bastion.Win32.Tests</RootNamespace>
    <AssemblyName>Bastion.Win32.Tests</AssemblyName>
    <Platforms>x64;arm64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!--
      No own NativeMethods.txt/json: this project consumes WindowProbe's already-compiled internal
      HWND/RECT surface via InternalsVisibleTo (src/Bastion.Win32/Properties/AssemblyInfo.cs), it
      does not regenerate any CsWin32 bindings of its own.
    -->
    <ProjectReference Include="..\..\src\Bastion.Win32\Bastion.Win32.csproj" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />

    <!-- FakeTimeProvider for deterministic Coalescer coalescing-window tests (testing.md §4). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />

    <!-- FakeLogger(T)/FakeLogCollector for asserting HookDiagnostics' [LoggerMessage] output
         (GitHub issue #14); Microsoft.Extensions.Logging.Abstractions itself (ILogger, NullLogger,
         LoggerMessageAttribute) already flows in transitively via Bastion.Win32's own
         Microsoft.Extensions.Hosting.Abstractions reference. -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" />
  </ItemGroup>

</Project>
