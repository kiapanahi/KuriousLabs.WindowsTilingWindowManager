<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  DESIGN.md §10: "Manifests: <dpiAwareness>PerMonitorV2</dpiAwareness>, asInvoker."
  bastiond never needs elevation for its default (unelevated) mode — DESIGN.md §3.10 covers the
  opt-in "manage elevated windows" mode separately via a Task Scheduler logon task, not via this
  manifest's execution level.

  Structure and exact namespaces (http, not https, for the SMI windowsSettings schemas; asmv3
  prefix bound to urn:schemas-microsoft-com:asm.v3) verified against:
  https://learn.microsoft.com/windows/win32/hidpi/setting-the-default-dpi-awareness-for-a-process
  https://learn.microsoft.com/windows/win32/sbscs/application-manifests
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <assemblyIdentity version="1.0.0.0" name="Bastion.Daemon" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <asmv3:application>
    <asmv3:windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10, Windows 11, and matching Server releases share this single GUID. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
