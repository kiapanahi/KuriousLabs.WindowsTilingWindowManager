<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>

    <!-- Matches Bastion.Win32.csproj's own TFM (GitHub issue #6) — a project referencing
         Bastion.Win32 cannot target a lower TargetPlatformVersion than it does (NU1201); see that
         project's comment for the full GetSystemMetricsForDpi/GetDpiForSystem rationale. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>Bastion.Daemon</RootNamespace>
    <AssemblyName>bastiond</AssemblyName>

    <!-- Composition root / executable — PublishAot, not IsAotCompatible (that's for libraries
         only; setting it here would have zero effect on publish). DESIGN.md §10, §3.9. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>

    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bastion.Core\Bastion.Core.csproj" />
    <ProjectReference Include="..\Bastion.Layout\Bastion.Layout.csproj" />
    <ProjectReference Include="..\Bastion.Win32\Bastion.Win32.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />

    <!--
      GitHub issue #9: [OptionsValidator]/[ValidateEnumeratedItems]/AddOptionsWithValidateOnStart
      (docs/engineering/daemon-architecture.md §4). Referenced directly (not left to incidental
      transitive availability via Microsoft.Extensions.Hosting) since this project depends on the
      OptionsValidator source generator directly, per learn.microsoft.com/dotnet/core/extensions/options-validation-generator:
      "automatically enabled by default when your project references Microsoft.Extensions.Options
      version 8 or later."
    -->
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <!--
    VSTHRD* (Microsoft.VisualStudio.Threading.Analyzers) is scoped to Bastion.Win32/Bastion.Daemon
    only — deliberately NOT a GlobalPackageReference. See docs/engineering/quality-gates.md §6.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <!--
    GitHub issue #9: the shipped curated rules seed (docs/engineering/json-ipc-config.md §2,
    DESIGN.md §9) ships next to bastiond.exe, versioned with the binary rather than copied into the
    user's profile on first run (WindowRulesConfigPaths' own remarks explain why). `Update`, not
    `Include`: the file already matches the SDK's default `**\*` None-item glob, so `Include` here
    would register a duplicate item (NETSDK1022); this only attaches CopyToOutputDirectory
    metadata to the already-globbed item.
  -->
  <ItemGroup>
    <None Update="rules.default.jsonc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
