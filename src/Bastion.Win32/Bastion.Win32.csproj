<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Windows-version-suffixed per GitHub issue #6: GetSystemMetricsForDpi/GetDpiForSystem
      (SystemMinTrackSizeReader) are the first APIs in this project requiring more than the
      unversioned "windows" (= 7.0, per the platform-compat analyzer's own documented default)
      baseline the bare "net10.0-windows" TFM implied — both are documented as
      "Minimum supported client: Windows 10, version 1607" (build 10.0.14393). This SDK's bundled
      Windows reference assemblies only ship a fixed set of TargetPlatformVersion milestones
      (confirmed empirically via NETSDK1140's own valid-values list: 7.0, 8.0, 10.0.17763,
      10.0.18362, 10.0.19041, 10.0.20348, 10.0.22000, 10.0.22621, 10.0.26100 — no 10.0.14393 entry
      exists) — 10.0.17763 (the "Windows 10 October 2018 Update" SDK) is the lowest of those that
      still satisfies the >= 10.0.14393 the actual APIs need, so it is used here rather than jumping
      straight to a newer/rounder value or DESIGN.md's actual Windows 11 25H2 product target. This
      keeps the platform-compatibility analyzer (CA1416) maximally useful: it still flags any future
      API needing something newer than what today's code has actually verified, rather than
      silently permitting anything up to an arbitrarily-chosen higher ceiling. This is a
      static-analysis-only input (which APIs are visible without a runtime guard) — it does not
      change what OS the compiled binary can run on, nor substitute for the product-level minimum
      Windows 11 25H2 requirement DESIGN.md states elsewhere.
    -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>Bastion.Win32</RootNamespace>
    <AssemblyName>Bastion.Win32</AssemblyName>
    <Platforms>x64;arm64</Platforms>

    <!-- Adapter ring — the only project touching HWND, CsWin32, or COM. DESIGN.md §3, §10. -->
    <IsAotCompatible>true</IsAotCompatible>

    <!--
      CsWin32 config contract, verbatim per docs/engineering/interop.md §1 — all three of these
      plus NativeMethods.json's allowMarshaling=false + comInterop.useComSourceGenerators=true
      are required together to get [GeneratedComInterface]-shaped COM projections rather than
      COM structs.
    -->
    <CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>
    <DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!--
      RS0030 (BannedApiAnalyzers) fires on CsWin32's generated NativeMethods.g.cs, which uses
      classic [DllImport] throughout — CsWin32 (pinned 0.3.298) has no setting to emit
      [LibraryImport] for plain P/Invokes instead (confirmed against its settings.schema.json;
      the only marshalling-source-generator toggle it exposes, comInterop.useComSourceGenerators,
      governs COM, not P/Invoke). Scoping the ban via .editorconfig glob to just the generated
      output does not work in practice (verified empirically: dotnet_diagnostic.RS0030.severity
      set to "none" under both a `**/Generated/CsWin32/**.cs` and a bare `*.g.cs` section left the
      error firing unchanged) — matching a currently-open upstream report that the same
      .editorconfig-scoping approach is "cumbersome" and does not cleanly work
      (https://github.com/microsoft/CsWin32/issues/1650). This project has zero hand-authored
      DllImport — the whole P/Invoke surface is CsWin32-generated — so a project-level NoWarn is
      the correct-scope suppression here, not a workaround-of-convenience; interop.md §2's
      LibraryImport rule is preserved for every hand-authored P/Invoke everywhere else in the repo.
    -->
    <NoWarn>$(NoWarn);RS0030</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bastion.Core\Bastion.Core.csproj" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />

    <!--
      WinEventPumpService (issue #1) and Coalescer (issue #2) implement
      IHostedService/BackgroundService so they can be registered from Bastion.Daemon's
      composition root, but this project is not itself a host/composition root — reference only
      the abstractions package that declares the interface/base class, not the full
      Microsoft.Extensions.Hosting meta-package.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <!--
    VSTHRD* (Microsoft.VisualStudio.Threading.Analyzers) is scoped to Bastion.Win32/Bastion.Daemon
    only — deliberately NOT a GlobalPackageReference. See docs/engineering/quality-gates.md §6.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
